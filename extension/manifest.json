{
  "manifest_version": 3,
  "name": "GMGN · 币安 Agent 快捷交易",
  "version": "0.5.10",
  "description": "在 GMGN BSC 页面通过 Binance Agentic Wallet 真实报价与买卖",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage",
    "clipboardRead",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://gmgn.ai/*",
    "https://www.gmgn.ai/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "打开币安 Agent 下单面板"
  },
  "content_scripts": [
    {
      "matches": [
        "https://gmgn.ai/*",
        "https://www.gmgn.ai/*"
      ],
      "js": [
        "panel-template.js",
        "content.js",
        "preset-model.js",
        "panel.js"
      ],
      "world": "ISOLATED",
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "panel.html",
        "panel.css",
        "panel.js",
        "preset-model.js"
      ],
      "matches": [
        "https://gmgn.ai/*",
        "https://www.gmgn.ai/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'"
  }
}
